# === Server Configuration ===
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins (no wildcard). Local dev: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# === Database (PostgreSQL) ===
# Leave empty to fallback to local JSON file database (db.json)
DATABASE_URL=

# === JWT Authentication ===
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRES_IN=24h

# Initial password for the seeded 'admin' account (>= 12 chars).
# If unset, a random one-time password is generated and printed on first migrate.
ADMIN_INITIAL_PASSWORD=

# === Messenger (Facebook FCA) Integration ===
# Key used to encrypt the Facebook appState (session cookies) at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSENGER_APPSTATE_ENC_KEY=
# Optional fallback to load an existing (plaintext JSON) appState on first boot.
MESSENGER_APPSTATE=
# Min delay between Messenger sends (ms). Add a little buffer to avoid FB rate-limit flags.
MESSENGER_MIN_INTERVAL_MS=1500
# Hard cap on Messenger messages sent per 24h.
MESSENGER_DAILY_CAP=400
# Health watchdog interval: re-logs-in Messenger if MQTT drops (ms).
MESSENGER_WATCHDOG_MS=120000

# === Supabase Storage ===
# Leave empty to fallback to local file storage (server/uploads/)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_NAME=Course

# === Telegram Integration ===
# Bot token from BotFather. Leave empty to use mock bot that logs messages.
TELEGRAM_BOT_TOKEN=

# === SMTP (Email) Configuration ===
# Used for password reset OTP, email verification, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# === File Expiry Configuration ===
FILE_EXPIRY_DAYS=15

# === WhatsApp Relay (optional) ===
# If using an external VPS relay for WhatsApp instead of Baileys directly.
# The relay REQUIRES a strong WHATSAPP_RELAY_SECRET (>= 16 chars) or it will refuse to boot.
WHATSAPP_RELAY_URL=
WHATSAPP_RELAY_SECRET=

# === Canva Integration (optional) ===
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# === Logging ===
LOG_LEVEL=debug
